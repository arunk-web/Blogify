<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %>
    <title>Blog</title>
</head>
<body>
    <!-- yha pr hm apne blog ko render krenge toh eske liye ye hh -->
    <%- include('./partials/nav') %>
    <div class="container mt-4">
        <h1><%= blog.title %></h1>
            <img src="<%= blog.coverImageURL %>" width="350px">
            <!-- <pre class="mt-3"><%= blog.body %></pre> -->
            <p class="mt-3" style="white-space: pre-wrap" ><%= blog.body %></p>
    </div>

    <div class="container mt-4">
        <img src="<%= blog.createdBy.profileImageURL ? blog.createdBy.profileImageURL : 'https://cdn-icons-png.flaticon.com/512/149/149071.png' %>" width="50px"> 
        <%= blog.createdBy.fullName %>
    </div>


    <div class="container mt-3">
        <h1>Comments (<%= comments.length %>) </h1>
        <!-- JO USER LOG IN HOGAA WHIII COMMENT KR PAYEGAA -->
        <% if (locals.user) { %>  
            <!-- <!-action me route likha jata haiii-  -->
            <form action="/blog/comment/<%= blog._id %>" method="post">
            <div class="mb-3">
                <!-- <label for="exampleInputEmail" class="form-label">Email address</label> -->
                <input 
                type="text" 
                class="form-control" 
                name="content"
                placeholder="Add a comment"
                >  
                <button class="btn btn-sm btn-primary mt-2" type="submit" >Comment</button>
            </div>
        </form>
        <% } %>
        
        <div class="mt-3">
            <% comments.forEach(comment => { %>
                <div>
                    <img src="<%= comment.createdBy.profileImageURL ? comment.createdBy.profileImageURL : 'https://cdn-icons-png.flaticon.com/512/149/149071.png' %>" width="50px" />
                    <%= comment.createdBy.fullName %>  
                    <!-- <pre><%= comment.content %></pre> -->
                    <p style="white-space: pre-wrap"><%= comment.content %></p>
                </div>
            <% }) %>
        </div>
    </div>
    

    <%- include('./partials/scripts') %>
</body>
</html>